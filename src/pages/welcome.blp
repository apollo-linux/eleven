using Gtk 4.0;
using Adw 1;

template $ElevenWelcomePage: Adw.Bin {
    child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            show-title: false;
            show-start-title-buttons: false;
            show-end-title-buttons: false;
        }

        Adw.StatusPage status_page {
            description: _("You can try {os_name} out in the live environment. When you’re ready to install, you can use this program to install {os_name} to this device");
        
            Box button_box {
                halign: center;
                orientation: horizontal;
                spacing: 16;

                Button try_btn {
                    label: _("Try Live");

                    styles [
                        "pill"
                    ]
                }

                Button install_btn {
                    label: _("Install {os_name}");

                    styles [
                        "pill",
                        "suggested-action"
                    ]
                }
            }
        }
    };
}
